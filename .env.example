# Copy to .env and fill in. Never commit .env.
# Databricks: host WITHOUT https://, the SQL warehouse HTTP path, and a personal access token.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=
# Snowflake uses key-pair login, not a password. See setup/snowflake_setup.sql for how to make and register the key.
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8   # unencrypted PKCS8 PEM
SNOWFLAKE_WAREHOUSE=BENCH_M                       # the runner switches to BENCH_L for option S2
SNOWFLAKE_ROLE=
